#!/bin/sh
set -eu

if [ "$(id -u)" -eq 0 ]; then
  printf '%s\n' 'Run rkwebscr-setup as the desktop user, not root.' >&2
  exit 1
fi

systemctl --user daemon-reload
systemctl --user enable --now rkwebscr-headless.service rkwebscr.service

address=$(hostname -I 2>/dev/null | awk '{print $1}')
printf 'rkwebscr is ready.\n'
printf '%s\n' 'Local: http://127.0.0.1:8080/'
if [ -n "$address" ]; then
  printf 'LAN:   http://%s:8080/\n' "$address"
fi
