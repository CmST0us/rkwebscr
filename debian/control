Package: rkwebscr
Architecture: any
Depends: ${shlibs:Depends},
 rockchip-mpp,
 python3,
 python3-gi,
 gir1.2-gstreamer-1.0,
 gir1.2-gst-plugins-base-1.0,
 gir1.2-gst-plugins-bad-1.0,
