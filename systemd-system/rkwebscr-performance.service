[Unit]
Description=Rockchip performance clocks for rkwebscr

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -ec 'for f in /sys/devices/system/cpu/cpufreq/policy*/scaling_governor; do printf performance > "$f"; done; printf performance > /sys/class/devfreq/fb000000.gpu/governor; printf performance > /sys/class/devfreq/dmc/governor'
ExecStop=/bin/sh -ec 'for f in /sys/devices/system/cpu/cpufreq/policy*/scaling_governor; do printf ondemand > "$f"; done; printf simple_ondemand > /sys/class/devfreq/fb000000.gpu/governor; printf dmc_ondemand > /sys/class/devfreq/dmc/governor'

[Install]
WantedBy=multi-user.target
